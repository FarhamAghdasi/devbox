# DevBox Environment Configuration
# Copy this file to .env and customize as needed.
# Values here override config/defaults.conf.
# Do NOT commit .env to version control.

# ---- Database ----
DB_ROOT_USER=root
DEFAULT_DB_HOST=127.0.0.1
DEFAULT_DB_PORT=3306

# ---- Services ----
APACHE_SERVICE=httpd
MARIADB_SERVICE=mariadb

# ---- Apache ----
APACHE_CONF_DIR=/etc/httpd/conf.d

# ---- phpMyAdmin ----
PHPMYADMIN_CONF=phpMyAdmin.conf
PHPMYADMIN_URL_BASE=http://localhost/phpmyadmin
PHPMYADMIN_DB_USER=phpmyadmin
# Set a fixed password for the phpMyAdmin MariaDB user.
# Leave empty to generate a random password on each setup.
# PHPMYADMIN_DB_PASS=
